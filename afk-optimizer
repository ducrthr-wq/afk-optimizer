-- =============================================================
-- Script Ultra AFK Optimizer (Frame-Budgeting & Anti-Spike Lag)
-- =============================================================

local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

-- 1. Cấu hình giới hạn FPS
if setfpscap then setfpscap(15) end
pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)

Lighting.GlobalShadows = false
Lighting.FogEnd = 9e9

-- -------------------------------------------------------------
-- 1. SMART CACHE CHARACTER (Không bao giờ giật lag khi kiểm tra Player)
-- -------------------------------------------------------------
local CharacterCache = {}

local function updateCharacterCache(char)
    if char then
        CharacterCache[char] = true
        char.Destroying:Connect(function()
            CharacterCache[char] = nil
        end)
    end
end

for _, p in ipairs(Players:GetPlayers()) do
    if p.Character then updateCharacterCache(p.Character) end
    p.CharacterAdded:Connect(updateCharacterCache)
end
Players.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(updateCharacterCache)
end)

-- -------------------------------------------------------------
-- 2. BỘ LỌC AN TOÀN CHO AUTO FARM
-- -------------------------------------------------------------
local function isImportant(obj)
    local model = obj:FindFirstAncestorOfClass("Model")
    
    -- Tra cứu cực nhanh qua Cache
    if model and CharacterCache[model] then
        return true
    end

    -- Giữ lại NPC / Quái có Humanoid
    if model and model:FindFirstChildOfClass("Humanoid") then
        return true
    end

    -- Bắt buộc giữ lại các Folder chứa Quái / Rương để Auto Farm không lỗi
    local parent = obj.Parent
    if parent then
        local pName = parent.Name
        if pName == "Enemies" or pName == "NPCs" or pName == "Characters" or pName == "Chest" or pName == "Chests" then
            return true
        end
    end

    return false
end

-- -------------------------------------------------------------
-- 3. HÀM XỬ LÝ (Đánh dấu trạng thái tránh trùng lặp)
-- -------------------------------------------------------------
local function optimizeObject(obj)
    if obj:GetAttribute("AFK_Optimized") then return end
    obj:SetAttribute("AFK_Optimized", true)

    if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") 
    or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") or obj:IsA("Highlight") then
        obj.Enabled = false
        return
    end

    if obj:IsA("Decal") or obj:IsA("Texture") or obj:IsA("SurfaceAppearance") then
        pcall(function() obj.Transparency = 1 end)
        return
    end

    if obj:IsA("BasePart") then
        if not isImportant(obj) then
            obj.Transparency = 1
            obj.CastShadow = false
        else
            obj.CastShadow = false
        end
    end
end

-- -------------------------------------------------------------
-- 4. KĨ THUẬT FRAME-BUDGETING (Phân bổ thời gian CPU - Chống Lag Khi Bật)
-- -------------------------------------------------------------
local descendants = Workspace:GetDescendants()

task.spawn(function()
    local startTime = tick()
    local maxTimePerFrame = 0.008 -- Cực kỳ nhẹ: Chỉ dành tối đa 8 millisecond mỗi frame để tối ưu
    
    for i = 1, #descendants do
        optimizeObject(descendants[i])
        
        -- Nếu thời gian xử lý vượt quá 8ms -> Nhường CPU cho Game render rồi tiếp tục
        if (tick() - startTime) >= maxTimePerFrame then
            RunService.Heartbeat:Wait()
            startTime = tick()
        end
    end
end)

-- -------------------------------------------------------------
-- 5. HÀNG ĐỢI XỬ LÝ VẬT THỂ MỚI (Micro-Batching Queue)
-- -------------------------------------------------------------
local ProcessQueue = {}

Workspace.DescendantAdded:Connect(function(obj)
    -- Nếu là Quái / NPC vừa xuất hiện -> Cho qua xử lý ngay lập tức để Auto Farm không bị trễ
    if isImportant(obj) then
        optimizeObject(obj)
    else
        -- Vật thể môi trường mới sẽ xếp hàng đợi xử lý đợt
        table.insert(ProcessQueue, obj)
    end
end)

-- Vòng lặp dọn dẹp hàng đợi mỗi 0.3 giây (Giảm thiểu tối đa tần suất chạy Event)
task.spawn(function()
    while true do
        task.wait(0.3)
        local queueSize = #ProcessQueue
        if queueSize > 0 then
            for i = 1, queueSize do
                optimizeObject(ProcessQueue[i])
            end
            table.clear(ProcessQueue)
        end
    end
end)

Lighting.ChildAdded:Connect(function(effect)
    if effect:IsA("PostEffect") or effect:IsA("Atmosphere") then
        pcall(function() effect.Enabled = false end)
    end
end)
                            
