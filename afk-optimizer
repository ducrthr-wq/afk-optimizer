-- =============================================================
-- Ultra AFK Optimizer - RAM Safe + Total Mute (No Black Screen)
-- Tối ưu RAM/CPU, giữ nguyên ánh sáng/môi trường 3D & Tắt âm thanh
-- =============================================================

local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")

-- true: xóa một số hiệu ứng/texture không quan trọng để giảm Instance.
-- Có thể làm một số game bị lỗi nếu script game cần các đối tượng đó.
local AGGRESSIVE_FREE = false

local MAX_TIME_PER_FRAME = 0.006
local MAX_OBJECTS_PER_FRAME = 250

-- FPS chủ yếu ảnh hưởng CPU/GPU, không giảm nhiều RAM.
if setfpscap then
    setfpscap(15)
end

pcall(function()
    settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
end)

-- =============================================================
-- TẮT ÂM THANH TOÀN CỤC (MUTE SOUND)
-- =============================================================

pcall(function()
    SoundService.Volume = 0
end)

-- =============================================================
-- WEAK TABLE
-- Không giữ Instance sống chỉ vì đang nằm trong bảng cache
-- =============================================================

local CharacterCache = setmetatable({}, {
    __mode = "k"
})

local OptimizedCache = setmetatable({}, {
    __mode = "k"
})

local QueuedCache = setmetatable({}, {
    __mode = "k"
})

local function registerCharacter(character)
    if character then
        CharacterCache[character] = true
    end
end

local function registerPlayer(player)
    if player.Character then
        registerCharacter(player.Character)
    end

    player.CharacterAdded:Connect(registerCharacter)
end

for _, player in ipairs(Players:GetPlayers()) do
    registerPlayer(player)
end

Players.PlayerAdded:Connect(registerPlayer)

-- =============================================================
-- KIỂM TRA ĐỐI TƯỢNG QUAN TRỌNG
-- =============================================================

local ImportantContainers = {
    Enemies = true,
    NPCs = true,
    Characters = true,
    Chest = true,
    Chests = true,
    Mobs = true,
    Bosses = true
}

local function isImportant(object)
    local model = object:FindFirstAncestorWhichIsA("Model")

    if model then
        if CharacterCache[model] then
            return true
        end

        if model:FindFirstChildOfClass("Humanoid") then
            return true
        end
    end

    -- Kiểm tra một số cấp cha thay vì chỉ kiểm tra Parent trực tiếp.
    local ancestor = object.Parent

    for _ = 1, 5 do
        if not ancestor then
            break
        end

        if ImportantContainers[ancestor.Name] then
            return true
        end

        ancestor = ancestor.Parent
    end

    return false
end

-- Chỉ xử lý loại Instance có thể tối ưu.
local function shouldProcess(object)
    return object:IsA("BasePart")
        or object:IsA("ParticleEmitter")
        or object:IsA("Trail")
        or object:IsA("Beam")
        or object:IsA("Smoke")
        or object:IsA("Fire")
        or object:IsA("Sparkles")
        or object:IsA("Highlight")
        or object:IsA("Decal")
        or object:IsA("Texture")
        or object:IsA("SurfaceAppearance")
        or object:IsA("Sound")
end

-- =============================================================
-- TỐI ƯU INSTANCE
-- =============================================================

local function optimizeObject(object)
    if not object or OptimizedCache[object] then
        return
    end

    OptimizedCache[object] = true

    -- Tắt và dừng âm thanh phát ra từ các Part/Model cụ thể
    if object:IsA("Sound") then
        pcall(function()
            object:Stop()
            object.Volume = 0
        end)
        return
    end

    local important = isImportant(object)

    if object:IsA("ParticleEmitter")
        or object:IsA("Trail")
        or object:IsA("Beam")
        or object:IsA("Smoke")
        or object:IsA("Fire")
        or object:IsA("Sparkles")
        or object:IsA("Highlight") then

        if AGGRESSIVE_FREE and not important then
            object:Destroy()
        else
            object.Enabled = false
        end

        return
    end

    if object:IsA("Decal") or object:IsA("Texture") then
        if AGGRESSIVE_FREE and not important then
            object:Destroy()
        else
            object.Transparency = 1
        end

        return
    end

    if object:IsA("SurfaceAppearance") then
        if AGGRESSIVE_FREE and not important then
            object:Destroy()
        end

        return
    end

    if object:IsA("BasePart") then
        object.CastShadow = false

        if not important then
            object.LocalTransparencyModifier = 1

            if AGGRESSIVE_FREE then
                pcall(function()
                    object.Material = Enum.Material.Plastic
                    object.Reflectance = 0
                end)

                if object:IsA("MeshPart") then
                    pcall(function()
                        object.TextureID = ""
                    end)
                end
            end
        end
    end
end

-- =============================================================
-- XỬ LÝ CÁC INSTANCE ĐANG CÓ
-- =============================================================

task.spawn(function()
    local objects = Workspace:GetDescendants()
    local frameStart = os.clock()

    for index = 1, #objects do
        local object = objects[index]

        objects[index] = nil

        if object and object.Parent and shouldProcess(object) then
            optimizeObject(object)
        end

        if os.clock() - frameStart >= MAX_TIME_PER_FRAME then
            RunService.Heartbeat:Wait()
            frameStart = os.clock()
        end
    end

    objects = nil
end)

-- =============================================================
-- HÀNG ĐỢI CHO INSTANCE MỚI
-- =============================================================

local ProcessQueue = {}
local QueueHead = 1
local QueueTail = 0

local function enqueue(object)
    if not shouldProcess(object) then
        return
    end

    if OptimizedCache[object] or QueuedCache[object] then
        return
    end

    QueueTail += 1
    ProcessQueue[QueueTail] = object
    QueuedCache[object] = true
end

Workspace.DescendantAdded:Connect(enqueue)

task.spawn(function()
    while true do
        RunService.Heartbeat:Wait()

        local processed = 0
        local frameStart = os.clock()

        while QueueHead <= QueueTail
            and processed < MAX_OBJECTS_PER_FRAME
            and os.clock() - frameStart < MAX_TIME_PER_FRAME do

            local object = ProcessQueue[QueueHead]

            ProcessQueue[QueueHead] = nil
            QueueHead += 1
            processed += 1

            if object then
                QueuedCache[object] = nil

                if object.Parent then
                    optimizeObject(object)
                end
            end
        end

        if QueueHead > QueueTail then
            ProcessQueue = {}
            QueueHead = 1
            QueueTail = 0
        end
    end
end)
